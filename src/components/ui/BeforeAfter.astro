---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  before: ImageMetadata
  after: ImageMetadata
  alt?: string
  beforeLabel?: string
  afterLabel?: string
  caption?: string
  // Cap the width, e.g. "393px" for mobile screenshots; centred when set
  maxWidth?: string
}

const { before, after, alt = '', beforeLabel = 'Before', afterLabel = 'After', caption, maxWidth } = Astro.props
---

<figure class="before-after" data-no-img-wrap style={maxWidth ? `max-width: ${maxWidth}` : undefined}>
  <div class="ba-frame" style="--pos: 50%">
    <Image src={after} alt={alt} class="ba-img" />
    <span class="ba-label ba-label-after" aria-hidden="true">{afterLabel}</span>
    <div class="ba-before" aria-hidden="true">
      <Image src={before} alt="" class="ba-img" />
      <span class="ba-label ba-label-before">{beforeLabel}</span>
    </div>
    <div class="ba-divider" aria-hidden="true"><span class="ba-handle"></span></div>
    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label={`Compare ${beforeLabel} and ${afterLabel}`}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .before-after {
    margin: 2rem auto;
  }

  .ba-frame {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    isolation: isolate;
    user-select: none;
    touch-action: pan-y;
  }

  /* Reset .prose img (post.css), which sets position: relative; z-index: 1 and would sit above every layer */
  .ba-frame :global(.ba-img) {
    position: static;
    z-index: auto;
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 0;
    pointer-events: none;
  }

  .ba-before {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba-before :global(.ba-img) {
    height: 100%;
    object-fit: cover;
  }

  .ba-divider {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    transform: translateX(-50%);
    background: #fff;
    box-shadow: 0 0 6px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.25rem;
    height: 2.25rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    /* Matches the Plyr play button (post.css sets --plyr-color-main: var(--emphasis)) */
    background: var(--emphasis);
    opacity: 0.9;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
    transition: opacity 0.3s;
  }

  .ba-frame:hover .ba-handle {
    opacity: 1;
  }

  .ba-handle::before,
  .ba-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    border: 5px solid transparent;
    transform: translateY(-50%);
  }

  .ba-handle::before {
    left: 5px;
    border-right-color: #fff;
  }

  .ba-handle::after {
    right: 5px;
    border-left-color: #fff;
  }

  /* Pills inside the frame, so they don't compete with <mark>s in the copy.
     The before label lives in the clipped layer and the after label sits under it,
     so the slider covers each one as it passes */
  .ba-label {
    position: absolute;
    z-index: 0;
    top: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .ba-label-before {
    left: 0.75rem;
  }

  .ba-label-after {
    right: 0.75rem;
  }

  .ba-range {
    position: absolute;
    z-index: 4;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba-frame:has(.ba-range:focus-visible) .ba-handle {
    outline: 2px solid var(--link-color, #2563eb);
    outline-offset: 2px;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    text-align: center;
    opacity: 0.7;
  }
</style>

<script>
  // Delegated once, so it keeps working across Astro page navigations
  document.addEventListener('input', (event) => {
    const target = event.target
    if (target instanceof HTMLInputElement && target.classList.contains('ba-range')) {
      target.closest<HTMLElement>('.ba-frame')?.style.setProperty('--pos', `${target.value}%`)
    }
  })
</script>
